{
  "name": "sapiens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:docker": "docker compose -f docker/docker-compose.yaml build app",
    "release:docker": "docker push mioyisama/sapiens:latest",
    "deploy:docker": "docker compose -f docker/docker-compose.yaml up",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "vpx auth@latest generate --config src/lib/auth/server.ts --output src/lib/db -y"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/i18n": "catalog:",
    "@fontsource-variable/noto-sans-sc": "catalog:",
    "@lobehub/icons-static-svg": "catalog:",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-anthropic": "catalog:",
    "@tanstack/ai-gemini": "catalog:",
    "@tanstack/ai-openai": "catalog:",
    "@tanstack/ai-react": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "nitro": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "srvx": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "oxc-transform-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.5",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  }
}
